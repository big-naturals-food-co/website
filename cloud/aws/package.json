{
  "name": "big-naturals-food-co-infrastructure",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.cjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "synth": "cdk synth --quiet",
    "synth:example": "cdk synth --context projectConfig=project.example.json --output cdk.out/example --quiet",
    "synth:access": "cdk synth --app 'node --import tsx bin/access.ts' --output cdk.out/access --quiet",
    "verify:certificate-access": "node --import tsx scripts/verify-certificate-access.ts",
    "publish:site": "node --import tsx scripts/publish-site.ts",
    "verify:site": "node --import tsx scripts/verify-site.ts"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "aws-cdk": "2.1147.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
